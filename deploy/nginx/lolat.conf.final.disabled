# The real production config - activate this AFTER the first certificate has
# been issued (see DEPLOY.md). To activate, from deploy/nginx/:
#   mv lolat.conf.final.disabled lolat.conf
# then `docker compose exec proxy nginx -s reload`. Named .disabled (not
# .conf) so nginx's conf.d/*.conf include doesn't load it - and therefore
# doesn't fail on a not-yet-issued certificate - while it sits next to the
# bootstrap config.
server {
    listen 80;
    server_name lolat.almutasim.site;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name lolat.almutasim.site;

    ssl_certificate     /etc/letsencrypt/live/lolat.almutasim.site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lolat.almutasim.site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Above the 2 MB channel-logo upload limit in UploadsController, with room
    # to raise the API-side limit later without also having to remember this.
    client_max_body_size 5m;

    location /api/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://api:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://web:80;
        proxy_set_header Host $host;
    }
}

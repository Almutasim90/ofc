# Copy this file to .env and fill in your real Supabase Postgres credentials.
# The backend (POS.API) loads this file automatically in Development.
SUPABASE_DB_CONNECTION=Host=db.xxxxxxxxxxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=CHANGE_ME;SSL Mode=Require;Trust Server Certificate=true

# JWT signing secret. If unset in Development, a random one is generated at each
# startup (fine for quick testing, but tokens won't survive a restart). Set a
# stable value here for normal dev use; a real secret is required in any
# non-Development environment.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ISSUER=POS.API
JWT_AUDIENCE=POS.Client

# Supabase Storage (self-hosted, reached through the Kong gateway - not the
# raw Postgres host above). Used for uploaded product/channel images so files
# are shared across every environment instead of living on one container's disk.
SUPABASE_URL=https://your-kong-domain.example.com
SUPABASE_SECRET_KEY=CHANGE_ME

# Independent SMTP settings for low-stock alerts (comma-separated recipients if supported by your SMTP server)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com
SMTP_ALERT_RECIPIENTS=manager@example.com

# docker-compose (production) only - see DEPLOY.md.
# Set to true for the first deploy so the API creates the schema and the
# bootstrap admin user; both steps are idempotent so it's safe to leave on
# for later deploys too, but you can flip it back to false once the schema
# is stable if you'd rather apply future migrations by hand.
RUN_MIGRATIONS_ON_STARTUP=true
